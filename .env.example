# PostgreSQL/Neon JDBC URL. Keep the jdbc: prefix and require TLS in production.
DATABASE_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DATABASE_USERNAME=your-neon-user
DATABASE_PASSWORD=replace-with-your-neon-password

# Optional. Defaults to the version declared in pom.xml.
APP_VERSION=0.1.0-SNAPSHOT

# Optional locally. Render injects PORT automatically.
PORT=8080

# Frontend origin allowed to call the REST API.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Required. Use a unique random secret with at least 32 UTF-8 bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional. JWT lifetime in seconds; defaults to one hour.
JWT_EXPIRATION_SECONDS=3600
